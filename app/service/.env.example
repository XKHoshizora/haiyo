# Copy to .env (git-ignored) and fill in. Never commit real values.
DATABASE_URL=postgres://agent_family:CHANGE_ME@127.0.0.1:5432/af_dev
TEST_DATABASE_URL=postgres://agent_family:CHANGE_ME@127.0.0.1:5432/af_test

APP_ORIGIN=http://localhost:5173
AUTH_SECRET=CHANGE_ME_to_a_random_string_of_at_least_32_characters
# Encrypts providers' API keys at rest; at least 32 characters; REQUIRED (the service will not start without it).
# Changing it makes every stored provider key unreadable.
PROVIDER_KEY_SECRET=CHANGE_ME_to_another_random_string_of_at_least_32_characters
BLOB_DIR=./data/blobs
# Directory of the built web client (app/web/dist) to serve from the same origin; empty serves only the API
WEB_DIST=
PORT=3000

# Optional S3-compatible object storage (leave empty to use BLOB_DIR)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# invite | open
REGISTRATION_MODE=invite
# outbox is the only mode in this plan
MAIL_MODE=outbox
# Multiplier applied to every rate limit (1 = production values; tests raise it)
RATE_LIMIT_SCALE=1
# Where address-based rate limits get the client's address (default: the connection's address).
# CLIENT_IP_HEADER: a header your proxy sets, replacing any client value (Railway: x-real-ip).
CLIENT_IP_HEADER=
# TRUST_PROXY: comma-separated addresses/CIDRs of your proxies; X-Forwarded-For is read only on
# connections from them. Empty trusts nothing. A bare true or a hop count is refused at start-up.
TRUST_PROXY=
# Largest single file, in bytes: 1 MiB to 5 GiB, and not more than the quota below (default 1 GiB)
ATTACHMENT_MAX_BYTES=1073741824
# Attachment bytes one principal may store in total, sent or not (default 20 GiB)
ATTACHMENT_QUOTA_BYTES=21474836480
# Uploads are cut off after this long without body bytes, or after this long in all
UPLOAD_IDLE_TIMEOUT_MS=45000
UPLOAD_TOTAL_TIMEOUT_MS=3600000
# A request must arrive whole within this long after its head, or the connection closes (accepted uploads excepted)
HTTP_BODY_TIMEOUT_MS=30000
# Server-wide: socket idle, whole request (empty: upload total + 1 min), idle keep-alive
HTTP_CONNECTION_TIMEOUT_MS=120000
HTTP_REQUEST_TIMEOUT_MS=
HTTP_KEEP_ALIVE_TIMEOUT_MS=72000
# Postgres statement_timeout of every pool connection, and of each search (busy 503 when exceeded)
DB_STATEMENT_TIMEOUT_MS=30000
SEARCH_STATEMENT_TIMEOUT_MS=3000
# How long a request waits for one of the pool's 10 connections before 503 busy
DB_ACQUIRE_TIMEOUT_MS=10000

# Models the site offers, a JSON array on one line; empty means none. Each entry:
#   {"id","label","tier":"free"|"paid","protocol":"openai_chat"|"openai_responses"|"anthropic"|"gemini","baseUrl",
#    "apiKeyEnv":"NAME_OF_ANOTHER_VARIABLE_HOLDING_THE_KEY","model","inputMicroPerToken","outputMicroPerToken",
#    "maxOutputTokens","contextTokens","vision","pdf","reasoning":["low","high"]}
#   and optionally "thinkingSwitch":true (openai_chat only: an upstream that thinks unless told not to, such as
#   DeepSeek; it is then sent thinking: {"type":"disabled"} at none and {"type":"enabled"} at a level; default false)
#   and "tools":false (its replies are offered no tools: for a model measured unable to use them; default true)
# Prices are whole micro-points per token (1 point = 1000000 micro-points). The key itself never goes in this JSON.
SITE_MODELS=
# The judgement model that decides whether an Agent replies without being @-mentioned, JSON; empty means none (then no
# Agent does, and the setting is refused). {"model","channels":[{"url","apiKeyEnv"}] (1 or 2, tried in order; the https
# URL requests are POSTed to, kept exactly as given, no credentials, query or fragment; apiKeyEnv names ANOTHER variable
# that holds the key and must be set),"timeoutMs":4000 (500-30000),"dailyLimit":20000 (judgements a site day, 1-10000000)}
JUDGE=
# Tunings of those proactive replies, JSON, every field optional (empty: the calibrated defaults): debounceMs,
# transcriptMessages, transcriptChars, base {less,normal,more}, surchargeStep, surchargeMax, surchargeHalfLifeS,
# surchargeHalfMessages, quietSmall and quietBig {at,raise,halfLifeS}, cap, fuse {perSeconds,perHour}, perGroupHour and
# perSenderHour (judgements an hour at most about one group, and about one sender's messages; default 600 and 300)
# (README.md, Proactive replies)
PROACTIVE=
# What bounds a reply's tools, JSON, every field optional (empty: the defaults): enabled (default true; false: no reply
# is offered any tool), maxRounds (rounds of one reply that may call tools, 1-50, default 8), maxPoints (whole points one
# reply may spend before it must answer, 1-100000, default 20), searchPerReply, filePerReply and timePerReply (calls of
# the search, the file and the clock tool one reply may run, 1-1000, default 6, 4 and 1), resultMaxWeight (the most one
# tool result weighs when it goes
# back to the model, 1-100000, default 3000), runTimeoutMs (how long a reply with tools may take in all, 1000-3600000,
# default 300000) (README.md, Agents and runs, Tools in a reply)
TOOLS=
# What one owner's open holds may add up to, JSON, every field optional (empty: the default): maxOpenShare (an admission
# rule: the share of what is left of the free allowance or the balance that the owner's running calls, a starting reply's
# own hold included, may hold against it before that reply waits, queued; 0.01-1, default 1) (README.md, Metering, Money
# that does not block)
HOLDS=
# When an owner is reminded of the day's free allowance, JSON, every field optional (empty: the default): warnAt (the
# share of it used at which they are told, once a day; above 0 and below 1, default 0.8) (README.md, Metering, Reminders)
ALLOWANCE=
# How long whispers stay open, JSON, every field optional (empty: the default): elsewhereTtlHours (a found-elsewhere whisper
# expires this many hours after it was made; 1-168, default 24; other kinds stay open 7 days) (README.md, Whispers)
WHISPERS=
# Free daily allowance of site-model use, in whole points (default 200)
FREE_DAILY_POINTS=200
# IANA time zone whose midnight starts a new free-allowance day (default Asia/Shanghai)
SITE_TIMEZONE=Asia/Shanghai
# How many Agents an account of each tier may own, JSON; must contain "free" (default {"free":20})
AGENT_TIERS={"free":20}
# Protective limits (whole numbers; empty: the default). Model calls (replies and persona drafts together) one person
# may have running at once (1-100, default 4)
AGENT_MAX_CONCURRENT_RUNS=4
# Of those, how many may be replies someone other than the Agent's owner called for (1-100, default 3; not more than
# AGENT_MAX_CONCURRENT_RUNS, or the service refuses to start)
AGENT_MAX_CONCURRENT_OTHERS_RUNS=3
# Replies one owner may start a minute that they called for themselves (1-10000, default 20; not scaled by
# RATE_LIMIT_SCALE)
AGENT_RUNS_PER_MINUTE=20
# Replies one owner's Agents may start a minute that anyone else called for, all together (1-10000, default 20)
AGENT_OTHERS_RUNS_PER_MINUTE=20
# Calls one person may make a minute on other people's Agents (1-10000, default 5)
AGENT_CALLER_RUNS_PER_MINUTE=5
# How long one reply or persona draft may take, for a reply also the reading of its attachments, in ms
# (1000-3600000, default 120000)
AGENT_RUN_TIMEOUT_MS=120000
# A provider model's context when its owner gives none (1000-2000000, default 16000), and the output limit of every
# call to a provider model at reasoning none (1-1000000, default 2048; must be less than the context; a level adds its
# thinking allowance, below)
PROVIDER_DEFAULT_CONTEXT_TOKENS=16000
PROVIDER_DEFAULT_MAX_OUTPUT_TOKENS=2048
# Thinking allowance per reasoning level, JSON, tokens 0-200000 each (a level left out keeps its default): at a level
# other than none a call's output limit is its reply limit plus this, at most half of what the model's context leaves
# beside the reply limit; the points held while it runs cover it
REASONING_ALLOWANCE_TOKENS={"low":2000,"medium":6000,"high":12000,"xhigh":24000,"max":48000}
# Calls to providers and site models in flight at once in the whole service (1-1000, default 64)
PROVIDER_MAX_CONCURRENT_CALLS=64
# Replies the worker runs at once in the whole service (1-64, default 16). Each holds up to 20 MiB of attachments in
# memory, in up to about five copies at its peak: about 1.6 GiB at the default in the worst case
AGENT_MAX_RUNS_IN_FLIGHT=16
# In a group, once its last this many messages that are not notices were all sent by Agents, an Agent's message calls
# no other Agent until a person writes (2-500, default 30)
AGENT_CHAIN_LIMIT=30
# A reply in a group is shown at most this many tokens of the group's latest 80 messages, files included, by the
# service's estimate (a provider may bill an image or a PDF at more); its system text comes on top (2000-200000,
# default 12000). Its owner pays for what it is shown. An Agent's own conversation is limited by its model alone
AGENT_GROUP_CONTEXT_TOKENS=12000
