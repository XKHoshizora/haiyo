{
  "name": "agent-family-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx src/cli.ts migrate",
    "migrate:prod": "node --enable-source-maps dist/cli.js migrate",
    "invite:create": "tsx src/cli.ts invite:create",
    "invite:create:prod": "node --enable-source-maps dist/cli.js invite:create",
    "inbox:list": "tsx src/cli.ts inbox:list",
    "inbox:list:prod": "node --enable-source-maps dist/cli.js inbox:list",
    "mail:status": "tsx src/cli.ts mail:status",
    "mail:status:prod": "node --enable-source-maps dist/cli.js mail:status",
    "attachments:sweep": "tsx src/cli.ts attachments:sweep",
    "attachments:sweep:prod": "node --enable-source-maps dist/cli.js attachments:sweep",
    "credits:grant": "tsx src/cli.ts credits:grant",
    "credits:grant:prod": "node --enable-source-maps dist/cli.js credits:grant",
    "credits:show": "tsx src/cli.ts credits:show",
    "credits:show:prod": "node --enable-source-maps dist/cli.js credits:show",
    "tier:set": "tsx src/cli.ts tier:set",
    "tier:set:prod": "node --enable-source-maps dist/cli.js tier:set",
    "models:list": "tsx src/cli.ts models:list",
    "models:list:prod": "node --enable-source-maps dist/cli.js models:list",
    "memory:stats": "tsx src/cli.ts memory:stats",
    "memory:stats:prod": "node --enable-source-maps dist/cli.js memory:stats",
    "demo:seed": "tsx src/cli.ts demo:seed",
    "demo:seed:prod": "node --enable-source-maps dist/cli.js demo:seed",
    "catalog:update": "node scripts/update-model-catalog.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/google": "^4.0.121",
    "@ai-sdk/openai": "^4.0.118",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-storage": "^3.1169.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "ai": "^7.0.173",
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "file-type": "^22.3.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "ws": "^8.23.0"
  }
}
